---
import HeaderLink from './HeaderLink.astro';

const currentPath = Astro.url.pathname;
---

<nav class="p-1 mt-8 border border-zinc-800 rounded-3xl flex items-center">
	<HeaderLink active={currentPath === "/"} text="Sobre" href="/">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"></circle><path d="M20 21a8 8 0 0 0-16 0"></path></svg>
	</HeaderLink>
	<HeaderLink active={currentPath.includes("/me")} text="Projetos" href="/me">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" x2="6" y1="3" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
	</HeaderLink>
</nav>
