---
const { href, icon, text, active = false } = Astro.props;

const baseClass = "w-28 py-2 flex items-center gap-2 justify-center text-md font-medium rounded-3xl";

const activeClass = `${baseClass} bg-white text-black`;
const inactiveClass = `${baseClass} text-zinc-400 hover:text-white transition duration-400`;

const classname = active ? activeClass : inactiveClass;
---

<a class={classname} href={href}>
	<slot />
	{text}
</a>
