---
import '../styles/skill.css'

const { name, src, alt, level, color } = Astro.props
---

<div class="flex flex-col gap-4 items-center transition duration-400 hover:scale-[1.1]">
  <p class="text-white font-bold text-lg">{name}</p>
  <img src={src} alt={alt} widht="50" class="w-[50px] mb-4">
  <div
    class="bg-zinc-800 w-20 h-2 relative skill-level"
    style={{
      '--level': level,
      '--color': color
    }}
  >
  </div>
</div>
